APP_MODE=production
APP_HTTPS=true
# Optional production runtime directory outside public/. Leave empty for var/production.
# APP_RUNTIME_DIR='D:\tempweb\var\production'
# Optional public base URL for existing promotion and carousel image filenames.
# WEBSITE_LEGACY_IMAGE_BASE_URL='https://example.com/images/promotions'
# 4-Domain architecture settings (example.com, www.example.com, api.example.com, admin.example.com).
# API_HOSTS='api.example.com'
# CUSTOMER_HOSTS='example.com,www.example.com'
# ADMIN_HOSTS='admin.example.com'
# CORS allowed origins for Backend API (exact scheme://host[:port], comma-separated).
# CUSTOMER_ORIGINS='https://example.com,https://www.example.com'
# ADMIN_ORIGINS='https://admin.example.com'
# Public domain and optional app subpath used to build full image links for uploaded files and frontend API calls.
# APP_PUBLIC_ORIGIN='https://api.example.com'
# VITE_API_BASE_URL='https://api.example.com'
# APP_BASE_PATH=''
# Optional comma-separated exact hostnames to restrict external image links, e.g. 'cdn.example.com' (leave empty to allow any valid http:// or https:// image URL).
# WEBSITE_ALLOWED_IMAGE_HOSTS='cdn.example.com,images.example.com'

DB_SERVER='192.168.2.4\SQLEXPRESS'
DB_DATABASE=DBITManagement
DB_USER=
DB_PASSWORD=
DB_TRUST_CERTIFICATE=false
DB_PRODUCT_SCHEMA=dbo
DB_PRODUCT_TABLE=Trade
DB_PRODUCT_ID=Trade_Id
DB_PRODUCT_CODE=Trade_Id
DB_PRODUCT_NAME=Trade_Name
DB_PRODUCT_BARCODE=
DB_PRODUCT_CATEGORY=Type_Name
DB_PRODUCT_UNIT=Unit_Name
DB_PRODUCT_PRICE=Sale_Price1
